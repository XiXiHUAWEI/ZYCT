# ============================================================
# 智愈错题 —— 环境变量示例文件
#
# 【怎么用】
#   1. 把本文件复制一份，改名为  .env      （注意开头有个点，没有后缀）
#   2. 打开 .env，把 DEEPSEEK_API_KEY 换成你自己的密钥
#   3. 重启后端服务
#
# 【为什么要有 .env.example 这个文件？】
#   真正的 .env 里有机密（你的 API Key），所以它被 .gitignore 忽略了，
#   不会上传到 GitHub。
#   但队友克隆你的代码时，需要知道该配哪些变量，
#   所以约定俗成放一个 .env.example 当作"填写模板"。
#
# ⚠️⚠️ 重要：这个文件是会被提交到 GitHub 的！
#         绝对不要把真实密钥写在这里，只能写占位符！
#         真实密钥请写进 .env
#
# 【重要】不要修改本文件！请复制一份改名为 .env 再改。
# ============================================================


# ------------------------------------------------------------
# ★ 必填：DeepSeek API Key
#
# 申请地址：https://platform.deepseek.com/api_keys
# 格式一般是 sk- 开头的一长串字符
# ------------------------------------------------------------
DEEPSEEK_API_KEY=sk-在这里粘贴你的密钥


# ------------------------------------------------------------
# 下面几项一般不用改
# ------------------------------------------------------------

# API 地址（官方地址，别改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名
# 如果报错说"模型不存在"，请到 https://platform.deepseek.com
# 查看你可用的模型名，然后改这里
DEEPSEEK_MODEL=deepseek-chat

# AI 超时时间（秒）。AI 有时候要想 10-20 秒，所以给得比较宽
DEEPSEEK_TIMEOUT=180

# 每次最多带多少条历史消息给 AI（约等于 10 轮对话）
# 调大 = AI 记得更多，但更慢更贵；调小 = 更快更便宜，但容易忘事
AI_MAX_HISTORY=10

# AI 单次最多输出多少 token。复杂题目的 JSON 比较长，
# 设太小会被截断导致解析失败。默认 2400。

# ★ 思考模式开关（官方默认是开的，打开会让内容跑到 reasoning_content 里，
#   导致正文为空、temperature 失效。我们只需要一小段 JSON，所以关掉它）
AI_THINKING=auto

# AI 单次最多输出多少 token（含思考消耗）。推理模型光想就花 300-400，
# 太小会把正文挤没，所以给到 6000。
AI_MAX_TOKENS=6000
